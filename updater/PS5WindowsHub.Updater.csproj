<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PS5WindowsHub.Updater</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UpdaterTestMode)' == 'true'">
    <DefineConstants>$(DefineConstants);UPDATER_TEST_MODE</DefineConstants>
  </PropertyGroup>
</Project>
